# Mythical AI environment sample file
# Copy this file to .env before running the project.

# Backend server configuration
API_BACKEND_HOST=0.0.0.0
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=2mb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PROXY_HEADER=MYTHICAL_AI_PROXY_HEADER

# Google Cloud / Vertex AI configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
API_KEY=your-google-api-key

# Persistent stores
DATABASE_URL=postgres://postgres:postgres@postgres:5432/mythical_ai
REDIS_URL=redis://redis:6379
VECTOR_DB_URL=http://vector-db:6333
VECTOR_DB_API_KEY=your-vector-db-api-key

# Optional security
ENCRYPTION_MASTER_KEY=replace-with-a-secure-32-byte-hex-key
