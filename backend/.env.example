API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_CLOUD_PROJECT=your-project-id

PROXY_HEADER=your-random-header

# PostgreSQL and Redis connection URLs
DATABASE_URL=postgres://user:password@localhost:5432/mythical_ai
